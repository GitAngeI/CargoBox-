<mxfile host="app.diagrams.net"><diagram name="1. Mapa de dominio" id="map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CargoBox – Mapa de dominio (DDD): agregados, entidades, value objects, servicios y eventos" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="leg0" value="Aggregate Root" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="150" height="28" as="geometry"/></mxCell><mxCell id="leg1" value="Entidad" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="205" y="58" width="150" height="28" as="geometry"/></mxCell><mxCell id="leg2" value="Value Object" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="58" width="150" height="28" as="geometry"/></mxCell><mxCell id="leg3" value="Servicio de dominio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="535" y="58" width="150" height="28" as="geometry"/></mxCell><mxCell id="leg4" value="Evento de dominio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="58" width="150" height="28" as="geometry"/></mxCell><mxCell id="legf" value="Línea punteada azul = límite del agregado" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="875" y="58" width="300" height="28" as="geometry"/></mxCell><mxCell id="F_paq" value="AGREGADO: Paquete (límite de consistencia del envío)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#3b6ea5;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=3;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="940" height="560" as="geometry"/></mxCell><mxCell id="paq" value="&lt;b&gt;Paquete&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;identidad: GuiaRastreo&lt;br&gt;&lt;div style=&quot;text-align:left;padding-left:10px;font-size:9px;&quot;&gt;Invariantes:&lt;br&gt;• «Entregado» exige EvidenciaRecepcion (BR012)&lt;br&gt;• Solo 1 segundo intento automático; el 3º requiere autorización (BR014)&lt;br&gt;• Los estados siguen el ciclo definido (sin saltos)&lt;br&gt;• La Tarifa la calcula el sistema y no se edita (BR005)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="400" height="200" as="geometry"/></mxCell><mxCell id="evr" value="&lt;b&gt;EventoRastreo&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br&gt;estado, fechaHora, instalación,&lt;br&gt;usuario (historial del paquete)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="240" height="90" as="geometry"/></mxCell><mxCell id="vo0" value="&lt;b&gt;GuiaRastreo&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;código único nacional&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo1" value="&lt;b&gt;Contacto&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;nombre, teléfono (remitente/destinatario)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="390" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo2" value="&lt;b&gt;Dimensiones&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;largo, ancho, alto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo3" value="&lt;b&gt;Peso&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;kilos (&amp;gt; 0)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo4" value="&lt;b&gt;Direccion&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;calle, número, colonia, ciudad, CP&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo5" value="&lt;b&gt;NivelServicio&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Estándar | Exprés, días de entrega&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo6" value="&lt;b&gt;Tarifa&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;total (Dinero MXN) + desglose&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo7" value="&lt;b&gt;EstadoEnvio&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Recibido … Entregado, Rechazado…&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="480" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo8" value="&lt;b&gt;EvidenciaRecepcion&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;firma, foto, receptor, fecha&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo9" value="&lt;b&gt;AutorizacionReintento&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;autorizado por, fecha&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="190" height="75" as="geometry"/></mxCell><mxCell id="vo10" value="&lt;b&gt;Instalacion&lt;/b&gt;&lt;br&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;sucursal o centro (id, ciudad)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="570" width="190" height="75" as="geometry"/></mxCell><mxCell id="F_inc" value="AGREGADO: Incidencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#3b6ea5;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=3;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="420" height="190" as="geometry"/></mxCell><mxCell id="inc" value="&lt;b&gt;Incidencia&lt;/b&gt; &lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;ticket de Atención al cliente (dirección incorrecta, daño, pérdida)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="380" height="80" as="geometry"/></mxCell><mxCell id="ti" value="&lt;b&gt;TipoIncidencia&lt;/b&gt;&lt;br&gt;«VO»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="255" width="180" height="45" as="geometry"/></mxCell><mxCell id="ei" value="&lt;b&gt;EstadoIncidencia&lt;/b&gt;&lt;br&gt;«VO»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="255" width="180" height="45" as="geometry"/></mxCell><mxCell id="F_man" value="AGREGADO: ManifiestoViaje" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#3b6ea5;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=3;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="1080" y="340" width="420" height="170" as="geometry"/></mxCell><mxCell id="man" value="&lt;b&gt;ManifiestoViaje&lt;/b&gt; &lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;agrupa guías de una unidad interurbana" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="380" height="70" as="geometry"/></mxCell><mxCell id="inst2" value="&lt;b&gt;Instalacion&lt;/b&gt; (origen/destino)&lt;br&gt;«VO»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="460" width="180" height="40" as="geometry"/></mxCell><mxCell id="em" value="&lt;b&gt;EstadoManifiesto&lt;/b&gt;&lt;br&gt;«VO»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="460" width="180" height="40" as="geometry"/></mxCell><mxCell id="F_rut" value="AGREGADO: RutaReparto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#3b6ea5;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=3;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="420" height="145" as="geometry"/></mxCell><mxCell id="rut" value="&lt;b&gt;RutaReparto&lt;/b&gt; &lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;guías de un repartidor en una jornada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="575" width="380" height="55" as="geometry"/></mxCell><mxCell id="er" value="&lt;b&gt;EstadoRuta&lt;/b&gt; «VO»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="640" width="180" height="35" as="geometry"/></mxCell><mxCell id="F_tab" value="AGREGADO: TabuladorTarifas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#3b6ea5;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=3;fontColor=#3b6ea5;" vertex="1" parent="1"><mxGeometry x="1560" y="120" width="420" height="250" as="geometry"/></mxCell><mxCell id="tab" value="&lt;b&gt;TabuladorTarifas&lt;/b&gt; &lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;versión y vigencia de las reglas de precio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="160" width="380" height="75" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;ReglaTarifa&lt;/b&gt; &lt;i&gt;«Entity»&lt;/i&gt;&lt;br&gt;rango de peso/volumen, zona, nivel, precio base" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1580" y="250" width="380" height="55" as="geometry"/></mxCell><mxCell id="din" value="&lt;b&gt;Dinero&lt;/b&gt; «VO»&lt;br&gt;monto + moneda MXN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1580" y="320" width="180" height="40" as="geometry"/></mxCell><mxCell id="dstitle" value="Servicios de dominio" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1560" y="395" width="300" height="25" as="geometry"/></mxCell><mxCell id="calc" value="&lt;b&gt;CalculadoraTarifa&lt;/b&gt; &lt;i&gt;«Domain Service»&lt;/i&gt;&lt;br&gt;aplica el tabulador a peso, dimensiones, destino y nivel de servicio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1560" y="425" width="420" height="70" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;PoliticaEstancamiento&lt;/b&gt; &lt;i&gt;«Domain Service»&lt;/i&gt;&lt;br&gt;decide si un paquete está estancado según el umbral (24/48 h)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1560" y="515" width="420" height="70" as="geometry"/></mxCell><mxCell id="ev1" value="&lt;div style=&quot;text-align:left;padding:4px 10px;&quot;&gt;&lt;b&gt;Eventos de dominio emitidos por Paquete&lt;/b&gt;&lt;br&gt;PaqueteRecibido · PaqueteClasificado · PaqueteEnTransito · PaqueteLlegoACentroDestino · PaqueteEnReparto · PaqueteEntregado · SegundoIntentoProgramado · TercerIntentoRequiereAutorizacion · EntregaPausada · PaqueteRetenidoPorIncidencia · PaqueteRechazado · DevolucionIniciada · PaqueteEstancadoDetectado&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="940" height="120" as="geometry"/></mxCell><mxCell id="ev2" value="&lt;div style=&quot;text-align:left;padding:4px 10px;&quot;&gt;&lt;b&gt;Eventos de otros agregados&lt;/b&gt;&lt;br&gt;&lt;b&gt;Incidencia:&lt;/b&gt; IncidenciaAbierta · IncidenciaResuelta&lt;br&gt;&lt;b&gt;ManifiestoViaje:&lt;/b&gt; ManifiestoDespachado · ManifiestoArribado (los paquetes reaccionan a estos eventos)&lt;br&gt;&lt;b&gt;RutaReparto:&lt;/b&gt; RutaIniciada · RutaCerrada&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">